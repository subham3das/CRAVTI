################################
# CRAVITI FRONTEND (RESTAURANT & ADMIN) (.env.example)
# Only expose safe public variables starting with VITE_
################################

# Production Backend API URL
VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_URL=https://your-backend.onrender.com/api

# WebSocket Server URL (Socket.IO)
VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=https://your-backend.onrender.com

# Application Brand & Environment
VITE_APP_NAME=Craviti
VITE_APP_ENV=production

# Public Payment Gateway Key (Razorpay Key ID - Never put Key Secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_PUBLIC_KEY
VITE_PAYMENT_PROVIDER=razorpay

# Support & Communication
VITE_SUPPORT_EMAIL=support@yourdomain.com

# Inter-App Navigation URLs (Optional)
VITE_RESTAURANT_URL=https://your-restaurant-domain.vercel.app
VITE_ADMIN_URL=https://your-admin-domain.vercel.app
