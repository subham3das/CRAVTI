################################
# CRAVITI PUBLIC MARKETING WEBSITE (.env.example)
# Only expose safe public variables starting with NEXT_PUBLIC_
################################

# Backend API Endpoint
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Public Website Canonical Domain
NEXT_PUBLIC_WEBSITE_URL=https://yourdomain.com

# Company & Support Contact Info
NEXT_PUBLIC_COMPANY_NAME=Craviti
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_PHONE=+91 (800) 272-8484

# Public Payment Gateway Key (Optional for upfront subscriptions)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_YOUR_PUBLIC_KEY

# Linked Application Domains
NEXT_PUBLIC_APP_URL=https://your-restaurant-domain.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://your-admin-domain.vercel.app
NEXT_PUBLIC_SOCKET_URL=https://your-backend.onrender.com
